{
	"_comment_": "copy to new projects (cd into project first): cp /Users/olof/Library/Mobile\ Documents/com\~apple\~CloudDocs/extDev/_shared/swift-format.json .swift-format",
	"rules": {
		"NoAccessLevelOnExtensionDeclaration": false,
	},
	"indentation" : {
		"tabs" : 1
	},
	"indentBlankLines" : true,
	"lineBreakAroundMultilineExpressionChainComponents" : false,
	"lineLength" : 9999,
	"tabWidth" : 4,
	"multiElementCollectionTrailingCommas" : true,
	"version" : 1
}
